//@version=6
indicator("미국주식 스윙 v4.2", overlay=true, max_labels_count=300)

// 일봉 기준 보조 지표입니다. Python 스크리너가 재무 조건까지 포함한 최종 판정을 담당합니다.
// TradingView 데이터 제공 범위와 기업별 재무 공개 시점 차이 때문에 Pine 신호는 기술 조건만 표시합니다.
// 시장 환경은 위험 경고로 표시하며, 시장이 위험구간이라는 이유만으로 기술적 매수 신호를 차단하지 않습니다.

ema20 = ta.ema(close, 20)
ema10 = ta.ema(close, 10)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)
avgVol5 = ta.sma(volume, 5)
avgVol20 = ta.sma(volume, 20)
avgVol30 = ta.sma(volume, 30)
avgDollar30 = ta.sma(close * volume, 30)
roc63 = (close / close[63] - 1) * 100

[spyClose, spySma50, spySma200, spySma50_5, spyRoc63] = request.security("AMEX:SPY", timeframe.period,
     [close, ta.sma(close, 50), ta.sma(close, 200), ta.sma(close, 50)[5], (close / close[63] - 1) * 100],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

marketBull = spyClose > spySma200 and spySma50 > spySma200 and spySma50 > spySma50_5
marketRegime = marketBull ? "상승장" : "위험구간"
dailyChart = timeframe.isdaily
rs = roc63 - spyRoc63
trendStack = ema20 > sma50 and sma50 > sma200
sma50Rising = sma50 > sma50[5]
pullbackBar = low <= sma50 + 0.25 * atr14 and close >= sma50 - 0.25 * atr14
pullbackRecent = (pullbackBar or pullbackBar[1] or pullbackBar[2]) and close >= sma50 - 0.25 * atr14
dryBar = volume < avgVol20 * 0.90
dryRecent = dryBar or dryBar[1] or dryBar[2]
volumeExpansion = volume > avgVol20 * 1.10
barRange = high - low
bullCandle = close > open and barRange > 0 and (close - open) / barRange >= 0.40 and (close - low) / barRange >= 0.60 and close > high[1]
distance50Atr = atr14 > 0 ? (close - sma50) / atr14 : na
stopPct = close > 0 ? atr14 * 1.5 / close * 100 : na
initialStopPlan = close - atr14 * 1.5
oneRPlan = close - initialStopPlan
targetPlan = close + 2 * oneRPlan

score = (trendStack ? 2 : 0) + (sma50Rising ? 1 : 0) + (rs > 0 ? 2 : 0) + (pullbackRecent ? 2 : 0) + (bullCandle ? 1 : 0) + (volumeExpansion ? 1 : 0) + (rsi14 >= 55 and rsi14 < 68 ? 1 : 0)
technicalBuy = dailyChart and barstate.isconfirmed and close >= 10 and avgVol30 >= 1000000 and avgDollar30 >= 30000000 and trendStack and sma50Rising and rs > 0 and rsi14 >= 55 and rsi14 < 68 and pullbackRecent and dryRecent and volumeExpansion and bullCandle and distance50Atr >= 0 and distance50Atr <= 2 and stopPct <= 5 and score >= 7
setupSignal = dailyChart and barstate.isconfirmed and trendStack and sma50Rising and score >= 6 and not technicalBuy

plot(ema20, "EMA 20", color=color.new(color.teal, 0), linewidth=2)
plot(sma50, "SMA 50", color=color.new(color.orange, 0), linewidth=2)
plot(sma200, "SMA 200", color=color.new(color.blue, 0), linewidth=2)
plotshape(pullbackBar, title="눌림", text="눌림", style=shape.circle, location=location.belowbar, color=color.new(color.aqua, 0), textcolor=color.black, size=size.tiny)
plotshape(dryBar, title="거래량 감소", text="감소", style=shape.circle, location=location.bottom, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)
plotshape(volumeExpansion, title="거래량 증가", text="증가", style=shape.circle, location=location.bottom, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
plotshape(setupSignal, title="준비", text="준비", style=shape.labelup, location=location.belowbar, color=color.new(color.yellow, 0), textcolor=color.black)
plotshape(technicalBuy, title="매수", text="매수", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white)

var bool pendingEntry = false
var bool holding = false
var float pendingAtr = na
var float entryPrice = na
var float initialStop = na
var float oneR = na
var float target = na
var float currentStop = na
var float highestSinceEntry = na
var int holdingBars = 0
var string lastEvent = "없음"

pendingAtBarStart = pendingEntry
if technicalBuy and not holding and not pendingEntry
    pendingEntry := true
    pendingAtr := atr14
    lastEvent := "다음 거래일 시가 진입 대기"
if barstate.isconfirmed and pendingAtBarStart and not holding
    pendingEntry := false
    holding := true
    entryPrice := open
    initialStop := entryPrice - pendingAtr * 1.5
    oneR := entryPrice - initialStop
    target := entryPrice + 2 * oneR
    currentStop := initialStop
    highestSinceEntry := high
    holdingBars := 1
    lastEvent := "보유 시작"
else if barstate.isconfirmed and holding
    holdingBars += 1
    highestSinceEntry := math.max(highestSinceEntry, high)
    activeStop = currentStop
    if low <= activeStop
        holding := false
        lastEvent := activeStop >= entryPrice ? "손익분기/추적 손절" : "초기 손절"
    else if high >= target
        holding := false
        lastEvent := "2R 목표 도달"
    else if holdingBars >= 20
        holding := false
        lastEvent := "기간 청산"
    else
        breakevenStop = highestSinceEntry >= entryPrice + oneR ? entryPrice : initialStop
        trailStop = highestSinceEntry >= entryPrice + 1.5 * oneR ? ema10 - 0.5 * atr14 : initialStop
        // Stops computed from this confirmed bar become active on the next bar.
        currentStop := math.max(activeStop, math.max(breakevenStop, trailStop))

plot(holding ? entryPrice : na, "진입가", color=color.new(color.white, 0), style=plot.style_linebr)
plot(holding ? currentStop : na, "현재 손절가", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(holding ? target : na, "2R 목표가", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(holding ? initialStop : na, "초기 손절 계획", color=color.new(color.red, 65), style=plot.style_linebr)

alertcondition(technicalBuy, "기술적 매수", "기술 조건 매수 신호: 다음 거래일 시가 기준 계획을 확인하세요. Python 재무 조건은 별도 확인 필요")
alertcondition(setupSignal, "준비 신호", "스윙 준비 조건 충족")
alertcondition(barstate.isconfirmed and not marketBull, "시장 위험구간", "SPY 시장환경이 위험구간입니다")
alertcondition(barstate.isconfirmed and technicalBuy and volumeExpansion and rs > 0, "동적 매수", "상대강도와 거래량 증가를 포함한 확정봉 기술 매수 신호")

var table dash = table.new(position.top_right, 2, 18, bgcolor=color.new(color.white, 5), frame_color=color.new(color.gray, 30), frame_width=1, border_width=1)
f_bg(ok) => ok ? color.new(color.lime, 78) : color.new(color.red, 80)
f_yes(ok) => ok ? "예" : "아니오"
f_num(v) => na(v) ? "—" : str.tostring(v, "#.##")
if barstate.islast
    table.cell(dash, 0, 0, "미국주식 스윙", bgcolor=color.rgb(230, 240, 250), text_color=color.black)
    table.cell(dash, 1, 0, "v4.2 / 일봉 기술", bgcolor=color.rgb(230, 240, 250), text_color=color.black)
    table.cell(dash, 0, 1, "시장환경")
    table.cell(dash, 1, 1, marketRegime, bgcolor=marketBull ? color.new(color.green, 70) : color.new(color.red, 65))
    table.cell(dash, 0, 2, "추세 배열")
    table.cell(dash, 1, 2, f_yes(trendStack), bgcolor=f_bg(trendStack))
    table.cell(dash, 0, 3, "50일선 상승")
    table.cell(dash, 1, 3, f_yes(sma50Rising), bgcolor=f_bg(sma50Rising))
    table.cell(dash, 0, 4, "SPY 대비 강도")
    table.cell(dash, 1, 4, f_num(rs) + "%", bgcolor=f_bg(rs > 0))
    table.cell(dash, 0, 5, "50일선 눌림")
    table.cell(dash, 1, 5, f_yes(pullbackRecent), bgcolor=f_bg(pullbackRecent))
    table.cell(dash, 0, 6, "거래량 감소")
    table.cell(dash, 1, 6, f_yes(dryRecent), bgcolor=f_bg(dryRecent))
    table.cell(dash, 0, 7, "거래량 증가")
    table.cell(dash, 1, 7, f_yes(volumeExpansion), bgcolor=f_bg(volumeExpansion))
    table.cell(dash, 0, 8, "강한 반등봉")
    table.cell(dash, 1, 8, f_yes(bullCandle), bgcolor=f_bg(bullCandle))
    table.cell(dash, 0, 9, "RSI14")
    table.cell(dash, 1, 9, f_num(rsi14), bgcolor=f_bg(rsi14 >= 55 and rsi14 < 68))
    table.cell(dash, 0, 10, "ATR 손절폭")
    table.cell(dash, 1, 10, f_num(stopPct) + "%", bgcolor=stopPct <= 5 ? color.new(color.green, 70) : stopPct <= 6 ? color.new(color.yellow, 65) : color.new(color.red, 65))
    table.cell(dash, 0, 11, "50일선 이격")
    table.cell(dash, 1, 11, f_num(distance50Atr) + " ATR", bgcolor=f_bg(distance50Atr >= 0 and distance50Atr <= 2))
    table.cell(dash, 0, 12, "점수")
    table.cell(dash, 1, 12, str.tostring(score) + "/10", bgcolor=score >= 7 ? color.new(color.green, 70) : score == 6 ? color.new(color.yellow, 60) : color.new(color.red, 65))
    table.cell(dash, 0, 13, "기술 상태")
    table.cell(dash, 1, 13, holding ? "보유 중" : pendingEntry ? "다음 시가" : technicalBuy ? "매수(기술)" : setupSignal ? "준비" : "대기", bgcolor=holding or technicalBuy ? color.new(color.green, 65) : setupSignal ? color.new(color.yellow, 60) : color.new(color.gray, 85))
    table.cell(dash, 0, 14, "진입 추정 / 손절")
    table.cell(dash, 1, 14, holding ? f_num(entryPrice) + " / " + f_num(currentStop) : f_num(close) + " / " + f_num(initialStopPlan))
    table.cell(dash, 0, 15, "2R 목표가")
    table.cell(dash, 1, 15, holding ? f_num(target) : f_num(targetPlan))
    table.cell(dash, 0, 16, "보유기간")
    table.cell(dash, 1, 16, holding ? str.tostring(holdingBars) + "/20일" : "최대 20일")
    table.cell(dash, 0, 17, "마지막 이벤트")
    table.cell(dash, 1, 17, lastEvent)

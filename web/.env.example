# 기존 Supabase 프로젝트의 Project URL과 service_role 키를 사용하세요.
# service_role 키는 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 개인 포트폴리오 페이지 접근 비밀번호와 세션 서명 키
PORTFOLIO_ACCESS_PASSWORD=choose-a-strong-private-password
PORTFOLIO_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
